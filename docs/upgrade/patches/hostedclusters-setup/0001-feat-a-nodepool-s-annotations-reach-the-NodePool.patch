+"""Keys of a nodepool[] entry that reach its NodePool beyond the GitLab copy's.
+
+An entry's annotations reach the NodePool as written, after the chart's own
+sync-wave. Without the key every cluster file renders exactly as before: the
+golden parity tests hold that.
+
+Requirements: helm CLI on PATH (module-level skip marker).
+"""
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+import yaml
+
+CHART = Path(__file__).resolve().parent.parent
+FIXTURES = CHART / "tests" / "fixtures" / "hostedcluster"
+POOL = {"infraEnvName": "dell-r660-128c-1024gb", "replicas": 3, "labels": {"allowDeletion": False}}
+
+pytestmark = pytest.mark.skipif(shutil.which("helm") is None, reason="helm CLI not available")
+
+
+def _nodepool(tmp_path: Path, **entry: object) -> dict:
+    """The NodePool of one agent nodepool entry, on the production-agent fixture."""
+    values = tmp_path / "nodepool.yaml"
+    values.write_text(yaml.safe_dump({"nodepool": [{**POOL, **entry}]}))
+    r = subprocess.run(
+        ["helm", "template", "t", str(CHART), "--set-string", "clusterName=tenant-a",
+         "-f", str(FIXTURES / "production-agent.yaml"), "-f", str(values)],
+        capture_output=True, text=True,
+    )
+    assert r.returncode == 0, r.stderr
+    (nodepool,) = [d for d in yaml.safe_load_all(r.stdout) if d and d["kind"] == "NodePool"]
+    return nodepool
+
+
+def test_an_entrys_annotations_reach_the_nodepool_after_the_charts_sync_wave(tmp_path):
+    nodepool = _nodepool(tmp_path, annotations={"redbull.io/scale-down-policy": "fewest-pods"})
+    assert nodepool["metadata"]["annotations"] == {
+        "argocd.argoproj.io/sync-wave": "4",
+        "redbull.io/scale-down-policy": "fewest-pods",
+    }
+    assert nodepool["metadata"]["labels"] == {"allowDeletion": "false", "maxReplicas": "3", "minReplicas": "2"}
+
+
+def test_without_annotations_the_nodepool_has_the_charts_alone(tmp_path):
+    assert _nodepool(tmp_path)["metadata"]["annotations"] == {"argocd.argoproj.io/sync-wave": "4"}
