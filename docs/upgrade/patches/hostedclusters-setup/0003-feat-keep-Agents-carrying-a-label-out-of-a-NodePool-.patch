diff --git a/README.md b/README.md
index 21be17e..8e8eba3 100644
--- a/README.md
+++ b/README.md
@@ -259,6 +259,7 @@ lists them):
 | `pausedUntil` | unset | the upgrade workflow's abort writes `"true"`: HostedCluster and every NodePool |
 | `nodepool[].storageClass` | unset | the KubeVirt root volume's storage class |
 | `nodepool[].additionalInfraEnvNames` | none | more InfraEnvs the NodePool draws Agents from: its `agentLabelSelector` is then `matchExpressions: [{key: infraenvs.agent-install.openshift.io, operator: In, values: [infraEnvName, ...these]}]` instead of `matchLabels`. The name still derives from `infraEnvName` |
+| `nodepool[].excludeAgentLabels` | none | Agent label keys the NodePool never takes an Agent with: its `agentLabelSelector` gains `matchExpressions` (the InfraEnvs' `In` requirement, then `{key: <label>, operator: DoesNotExist}` for each), beside `matchLabels` when there are no other InfraEnvs. herzi's collector of used Agents labels them so a freed used Agent is not bound again before it is deleted |
 | `nodepool[].annotations` | none | written onto the NodePool's `metadata.annotations` as given (`toYaml`), after the chart's own `argocd.argoproj.io/sync-wave`; values must be strings, and an entry does not set the sync-wave. The workflows' update-nodepool reads `redbull.io/scale-down-policy` (`fewest-pods`, `least-requested`, `least-utilized`) from it |
 
 `releaseRepo` (and `cpoRepo`) must describe the same layout as the upgrade rules'
diff --git a/templates/nodepool.yaml b/templates/nodepool.yaml
index 798f856..8d642c3 100644
--- a/templates/nodepool.yaml
+++ b/templates/nodepool.yaml
@@ -7,7 +7,8 @@
        MCE's own pod network, so no additionalNetworks / attachDefaultNetwork
        unless a nodepool sets them. Also fixed: a tuningConfig rendered the key
        twice. A nodepool's annotations reach its NodePool, as written, and a
-       nodepool may draw Agents from more InfraEnvs (additionalInfraEnvNames). */}}
+       nodepool may draw Agents from more InfraEnvs (additionalInfraEnvNames) and
+       keep out Agents carrying a label (excludeAgentLabels). */}}
 {{- if include "hc.enabled" . }}
 {{- $clusterName := include "hc.clusterName" . }}
 {{- $platform := .Values.platform | default "" }}
@@ -124,7 +125,8 @@ spec:
         {{- if not .additionalInfraEnvNames }}
         matchLabels:
           {{ $labelKey }}: {{ $infraEnv }}
-        {{- else }}
+        {{- end }}
+        {{- if or .additionalInfraEnvNames .excludeAgentLabels }}
         matchExpressions:
         - key: {{ $labelKey }}
           operator: In
@@ -133,6 +135,10 @@ spec:
           {{- range .additionalInfraEnvNames }}
           - {{ . | quote }}
           {{- end }}
+        {{- range .excludeAgentLabels }}
+        - key: {{ . | quote }}
+          operator: DoesNotExist
+        {{- end }}
         {{- end }}
     type: Agent
   {{- end }}
diff --git a/tests/test_nodepool_entry_keys.py b/tests/test_nodepool_entry_keys.py
index 14f02c8..17a2d67 100644
--- a/tests/test_nodepool_entry_keys.py
+++ b/tests/test_nodepool_entry_keys.py
@@ -3,8 +3,10 @@
 An entry's annotations reach the NodePool as written, after the chart's own
 sync-wave. An entry's additionalInfraEnvNames make its agentLabelSelector one
 matchExpressions In over infraEnvName and these, instead of matchLabels; the
-name still derives from infraEnvName. Without the keys every cluster file
-renders exactly as before: the golden parity tests hold that.
+name still derives from infraEnvName. An entry's excludeAgentLabels add one
+DoesNotExist requirement each after the In requirement, beside matchLabels
+when there are no other InfraEnvs. Without the keys every cluster file renders
+exactly as before: the golden parity tests hold that.
 
 Requirements: helm CLI on PATH (module-level skip marker).
 """
@@ -68,3 +70,27 @@ def test_other_infraenvs_make_one_in_requirement_with_the_first_first(tmp_path):
     }
     assert nodepool["metadata"]["name"] == "tenant-a-dell-r660-128c-1024gb"
 
+
+def test_excluded_labels_add_does_not_exist_beside_the_one_label(tmp_path):
+    nodepool = _nodepool(tmp_path, excludeAgentLabels=["example.com/used"])
+    assert _selector(nodepool) == {
+        "matchLabels": {LABEL: "dell-r660-128c-1024gb"},
+        "matchExpressions": [
+            {"key": LABEL, "operator": "In", "values": ["dell-r660-128c-1024gb"]},
+            {"key": "example.com/used", "operator": "DoesNotExist"},
+        ],
+    }
+
+
+def test_excluded_labels_follow_the_in_requirement_of_several_infraenvs(tmp_path):
+    nodepool = _nodepool(
+        tmp_path, additionalInfraEnvNames=["dell-r760-128c-1024gb"], excludeAgentLabels=["example.com/used", "b"]
+    )
+    assert _selector(nodepool) == {
+        "matchExpressions": [
+            {"key": LABEL, "operator": "In", "values": ["dell-r660-128c-1024gb", "dell-r760-128c-1024gb"]},
+            {"key": "example.com/used", "operator": "DoesNotExist"},
+            {"key": "b", "operator": "DoesNotExist"},
+        ],
+    }
