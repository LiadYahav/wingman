# Fixture placeholder: the generic network config, for a worker of any hardware.
# A nodepool lists it as plain nm-conf. The CI replaces {CLUSTER_NAME},
# {OPENSHIFT_VERSION} and VLAN_ID.
variant: openshift
version: {OPENSHIFT_VERSION}
metadata:
  name: 99-nm-conf-{CLUSTER_NAME}
  labels:
    machineconfiguration.openshift.io/role: worker
storage:
  files:
    - path: /etc/nmstate/placeholder-generic.yaml
      mode: 0644
      contents:
        inline: |
          # bond0.VLAN_ID, any hardware
